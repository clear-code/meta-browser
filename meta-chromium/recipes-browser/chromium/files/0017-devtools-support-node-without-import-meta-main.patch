From 4d9fcc277a6aaefb9dead833fae3675341220eb1 Mon Sep 17 00:00:00 2001
From: Takuro Ashie <ashie@clear-code.com>
Date: Tue, 1 Sep 2026 17:40:29 +0900
Subject: [PATCH] devtools: support Node versions without import.meta.main

The scarthgap recipe uses Node.js 22.11.0, which does not provide
import.meta.main. Check the entrypoint explicitly in both the CSS
generator and the AI skills generator so they produce their outputs.

This extends the Node compatibility workaround by Copilot, signed off
by Caner Altinbasak in scarthgap commit 85eeb6b5, using the final
Chromium 150 entrypoint checks.

Upstream-Status: Inappropriate [scarthgap Node.js compatibility]
Signed-off-by: Takuro Ashie <ashie@clear-code.com>
---
 .../devtools-frontend/src/scripts/build/build_ai_skills.mjs    | 3 ++-
 .../src/scripts/build/generate_css_js_files.js                 | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs b/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs
index 5cbc69112c..18c54cdbdf 100644
--- a/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs
+++ b/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs
@@ -5,6 +5,7 @@
 import yaml from 'js-yaml';
 import * as fs from 'node:fs';
 import * as path from 'node:path';
+import {fileURLToPath} from 'node:url';
 
 import {writeIfChanged} from './ninja/write-if-changed.js';
 
@@ -61,6 +62,6 @@ export const skill = ${JSON.stringify(skill, null, 2)};
   writeIfChanged(outputFile, outputContent);
 }
 
-if (import.meta.main) {
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
   runMain();
 }
diff --git a/third_party/devtools-frontend/src/scripts/build/generate_css_js_files.js b/third_party/devtools-frontend/src/scripts/build/generate_css_js_files.js
index 3d99fac3e1..54a71d92e2 100644
--- a/third_party/devtools-frontend/src/scripts/build/generate_css_js_files.js
+++ b/third_party/devtools-frontend/src/scripts/build/generate_css_js_files.js
@@ -5,6 +5,7 @@ import cssnano from 'cssnano';
 import cssnanoPresetLite from 'cssnano-preset-lite';
 import * as fs from 'node:fs';
 import * as path from 'node:path';
+import {fileURLToPath} from 'node:url';
 import postcss from 'postcss';
 
 import {writeIfChanged} from './ninja/write-if-changed.js';
@@ -80,6 +81,6 @@ async function runMain() {
   );
 }
 
-if (import.meta.main) {
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
   runMain();
 }
