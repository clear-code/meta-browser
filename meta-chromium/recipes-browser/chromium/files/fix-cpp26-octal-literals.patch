From 9592d0be3e0e70ebef0d72b49e13a48403a505c6 Mon Sep 17 00:00:00 2001
From: Copilot <223556219+Copilot@users.noreply.github.com>
Date: Wed, 6 May 2026 16:34:53 +0100
Subject: [PATCH] Use traditional octal literals with older Clang

Replace 0o666 with 0666 so the scarthgap compiler accepts the literal.

Refresh the existing scarthgap fix from meta-browser commit 85eeb6b5
(fix-cpp26-octal-literals.patch) for Chromium 150.
The original patch has no Date header; use its enclosing commit date.

Upstream-Status: Inappropriate [scarthgap compiler compatibility]
Signed-off-by: Caner Altinbasak <cal@brightsign.biz>
Signed-off-by: Takuro Ashie <ashie@clear-code.com>
---
 .../named_mojo_server_endpoint_connector_linux.cc               | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/components/named_mojo_ipc_server/named_mojo_server_endpoint_connector_linux.cc b/components/named_mojo_ipc_server/named_mojo_server_endpoint_connector_linux.cc
index c5cf0b732f..9b03be59f5 100644
--- a/components/named_mojo_ipc_server/named_mojo_server_endpoint_connector_linux.cc
+++ b/components/named_mojo_ipc_server/named_mojo_server_endpoint_connector_linux.cc
@@ -118,7 +118,7 @@ bool NamedMojoServerEndpointConnectorLinux::TryStart() {
   if (!options_.require_same_peer_user) {
     // Allow any user to write to the UDS. fchmod doesn't work after bind(), so
     // we need to call chmod on the socket filename, which is the server name.
-    if (chmod(options_.server_name.c_str(), 0o666) != 0) {
+    if (chmod(options_.server_name.c_str(), 0666) != 0) {
       PLOG(ERROR) << "chmod failed";
       return false;
     }
