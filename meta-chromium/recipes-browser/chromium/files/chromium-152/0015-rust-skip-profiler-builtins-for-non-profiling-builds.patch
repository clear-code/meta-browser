From 69b8fec1a90a8a1864dd2fae14d2cb434ec65e04 Mon Sep 17 00:00:00 2001
From: Takuro Ashie <ashie@clear-code.com>
Date: Tue, 17 Nov 2026 08:56:12 +0900
Subject: [PATCH 15/15] rust: skip profiler builtins for non-profiling builds

---
 build/rust/std/BUILD.gn | 1 -
 1 file changed, 1 deletion(-)

diff --git a/build/rust/std/BUILD.gn b/build/rust/std/BUILD.gn
index 105a1d52a1..d34bfac678 100644
--- a/build/rust/std/BUILD.gn
+++ b/build/rust/std/BUILD.gn
@@ -74,7 +74,6 @@ if (toolchain_has_rust) {
   # don't need to pass to the C++ linker because they're used for specialized
   # purposes.
   skip_stdlib_files = [
-    "profiler_builtins",
     "rustc_std_workspace_alloc",
     "rustc_std_workspace_core",
     "rustc_std_workspace_std",
