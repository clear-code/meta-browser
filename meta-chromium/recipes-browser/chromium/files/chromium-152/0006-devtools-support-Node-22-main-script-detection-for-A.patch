From 40c7562eb740b3e5cff67ced73d275f65d568347 Mon Sep 17 00:00:00 2001
From: Takuro Ashie <ashie@clear-code.com>
Date: Wed, 11 Nov 2026 16:55:27 +0900
Subject: [PATCH 06/15] devtools: support Node 22 main script detection for AI
 skills

(cherry picked from commit 395bc35faeec57c69d0a1d273b55d789f6cb3d46)
---
 .../devtools-frontend/src/scripts/build/build_ai_skills.mjs    | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs b/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs
index a3d873c541..723496f256 100644
--- a/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs
+++ b/third_party/devtools-frontend/src/scripts/build/build_ai_skills.mjs
@@ -5,6 +5,7 @@
 import yaml from 'js-yaml';
 import * as fs from 'node:fs';
 import * as path from 'node:path';
+import {fileURLToPath} from 'node:url';
 
 import {writeIfChanged} from './ninja/write-if-changed.js';
 
@@ -61,6 +62,6 @@ export const skill = ${JSON.stringify(skill, null, 2)};
   writeIfChanged(outputFile, outputContent);
 }
 
-if (import.meta.main) {
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
   runMain();
 }
