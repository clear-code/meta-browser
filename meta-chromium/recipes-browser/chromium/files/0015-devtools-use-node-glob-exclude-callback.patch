From effdc7f97311e8575276b2dcde4f5addbf26d6b9 Mon Sep 17 00:00:00 2001
From: Takuro Ashie <ashie@clear-code.com>
Date: Tue, 1 Sep 2026 16:02:48 +0900
Subject: [PATCH] devtools: use a callback for Node glob exclusions

Use a function-valued exclude option for fs.globSync() with the Node.js
used by the scarthgap recipe. Preserve the existing exclusion patterns.

Upstream-Status: Inappropriate [scarthgap Node.js compatibility]
Signed-off-by: Takuro Ashie <ashie@clear-code.com>
---
 .../src/front_end/core/i18n/collect-ui-strings.js          | 7 ++++++-
 .../src/third_party/i18n/collect-strings.js                | 7 ++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/third_party/devtools-frontend/src/front_end/core/i18n/collect-ui-strings.js b/third_party/devtools-frontend/src/front_end/core/i18n/collect-ui-strings.js
index 854e6b396f..4ded2b6192 100644
--- a/third_party/devtools-frontend/src/front_end/core/i18n/collect-ui-strings.js
+++ b/third_party/devtools-frontend/src/front_end/core/i18n/collect-ui-strings.js
@@ -70,7 +70,12 @@ for (const directory of inputDirectories) {
 
   const fs = globSync('**/*.{js,ts,gn}', {
     cwd: directory,
-    exclude: IGNORED_PATH_COMPONENTS,
+    exclude: entry => {
+      const components = entry.replaceAll('\\', '/').split('/');
+      return components.includes('.git') || components.includes('third_party') ||
+          components.some(component => component.endsWith('_test_runner')) ||
+          entry.endsWith('.test.ts');
+    },
   });
   files.push(...fs.map(f => path.join(directory, f)));
 }
diff --git a/third_party/devtools-frontend/src/third_party/i18n/collect-strings.js b/third_party/devtools-frontend/src/third_party/i18n/collect-strings.js
index 4f586cf850..76e8213249 100644
--- a/third_party/devtools-frontend/src/third_party/i18n/collect-strings.js
+++ b/third_party/devtools-frontend/src/third_party/i18n/collect-strings.js
@@ -649,7 +649,12 @@ export function collectAllStringsInDir(directory) {
   directory = path.relative(process.cwd(), directory);
   const files = fs.globSync('**/*.{js,ts}', {
     cwd: directory,
-    exclude: IGNORED_PATH_COMPONENTS,
+    exclude: entry => {
+      const components = entry.replaceAll('\\', '/').split('/');
+      return components.includes('.git') || components.includes('third_party') ||
+          components.some(component => component.endsWith('_test_runner')) ||
+          entry.endsWith('.test.ts');
+    },
   });
   for (const pathRelativeToDirectory of files) {
     const absolutePath = path.join(directory, pathRelativeToDirectory);
